---
import { store } from "@/data/store";
import SectionHeader from "@/components/ui/SectionHeader.astro";

const quotes = [
  "Tư vấn nhiệt tình, chọn đúng size nên chạy rất thoải mái.",
  "Lắp ráp kỹ, giao xe xong còn hướng dẫn bảo dưỡng chi tiết.",
  "Sửa nhanh, báo giá rõ ràng. Sẽ quay lại bảo dưỡng định kỳ.",
];
---

<section id="danh-gia" class="py-12">
  <div class="relative">
    <div class="pointer-events-none absolute -left-8 -top-8 h-28 w-28 rounded-full bg-orange-100/60 blur-2xl" />

  <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <SectionHeader
      kicker="Uy tín"
      title="Khách nói gì về Quốc Bản?"
      subtitle="Bạn có thể xem review gốc trên Google để tham khảo trải nghiệm thực tế."
    />
    <a
      class="px-4 font-extrabold h-10 text-xs bg-base-100 text-base-900 rounded-md flex items-center justify-center hover:bg-base-200 duration-200 w-fit"
      href={store.reviewsUrl}
      target="_blank"
      rel="noreferrer"
    >
      Xem đánh giá trên Google
    </a>
  </div>

  <div class="mt-6 grid gap-4 md:grid-cols-3">
    {quotes.map((q, i) => (
      <figure class="rounded-xl border border-base-100 bg-white p-6 shadow-sm">
        <div class="flex gap-1 text-orange-600 text-sm" aria-hidden="true">
          {"★★★★★".split("").map((s) => (
            <span>{s}</span>
          ))}
        </div>
        <blockquote class="text-sm text-base-700 leading-relaxed">“{q}”</blockquote>
        <figcaption class="mt-4 text-xs text-base-500">Khách hàng #{i + 1}</figcaption>
      </figure>
    ))}
  </div>
  </div>
</section>

