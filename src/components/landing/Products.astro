---
import { products } from "@/data/products";

function formatPrice(priceVnd?: number) {
  if (!priceVnd || priceVnd <= 0) return "Liên hệ";
  return new Intl.NumberFormat("vi-VN", { style: "currency", currency: "VND" }).format(priceVnd);
}
---

<section id="san-pham">
  <div
    class="grid grid-cols-1 gap-6 lg:gap-y-24 md:grid-cols-2 lg:grid-cols-3 py-12"
  >
    {
      products.map((product) => (
        <figure class="relative ">
          <a href={`/products/${product.slug}/`} aria-hidden="true" class="absolute inset-0" />
          <img
            width="800"
            height="800"
            alt={product.name}
            src={product.image}
            loading="lazy"
            class="w-full rounded-3xl shadow aspect-12/9 object-cover object-center"
          />
          <div class="mt-2 flex justify-between px-6">
            <div>
              <p class="mt-1 text-sm font-medium  text-base-900">
                {product.category}
              </p>
              <h3 class="text-xs text-base-500">{product.name}</h3>
            </div>
            <p class="text-base text-orange-600">{formatPrice(product.priceVnd)}</p>
          </div>
        </figure>
      ))
    }
  </div>
</section>
