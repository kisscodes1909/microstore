---
import "../styles/global.css";
import { store } from "@/data/store";

type Props = {
  title?: string;
  description?: string;
  /** Absolute (https://...) or site-root (/...) image URL for OG/Twitter previews */
  image?: string;
  /** Set true for filter/search pages to avoid duplicate indexing */
  noindex?: boolean;
  /** Override canonical path (e.g. "/products/") */
  canonicalPath?: string;
};

const {
  title = `${store.name} — ${store.area}`,
  description = store.description,
  image,
  noindex = false,
  canonicalPath,
} = Astro.props;

const origin = Astro.site?.href.replace(/\/$/, "") ?? Astro.url?.origin ?? "https://example.com";
const canonicalUrl = new URL(canonicalPath ?? Astro.url?.pathname ?? "/", origin).href;
const ogImage = image
  ? image.startsWith("http")
    ? image
    : new URL(image, origin).href
  : undefined;
const gaMeasurementId = import.meta.env.PUBLIC_GA_ID;

/** Đường dẫn tới asset trong `public/` (đúng cả khi có `base` trong astro.config) */
const faviconHref = `${import.meta.env.BASE_URL}favicon.svg`.replace(/\/{2,}/g, "/");
/** Đổi ?v= khi đổi file favicon — tránh tab vẫn dùng bản cache cũ / 404 */
const faviconBust = "?v=2";
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" href={`${faviconHref}${faviconBust}`} type="image/svg+xml" sizes="any" />
<link rel="shortcut icon" href={`${faviconHref}${faviconBust}`} type="image/svg+xml" />
<link rel="apple-touch-icon" href={`${faviconHref}${faviconBust}`} />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />

<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content="vi_VN" />
{ogImage ? <meta property="og:image" content={ogImage} /> : null}

<meta property="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
{ogImage ? <meta property="twitter:image" content={ogImage} /> : null}

<link rel="canonical" href={canonicalUrl} />

<meta name="theme-color" content="#1d4ed8" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />

{
  gaMeasurementId && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
      <script is:inline>
        {`
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', '${gaMeasurementId}');
        `}
      </script>
    </>
  )
}

<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "Store", "BikeStore"],
    name: store.name,
    description,
    telephone: store.phoneDisplay,
    url: canonicalUrl,
    address: {
      "@type": "PostalAddress",
      addressCountry: "VN",
      streetAddress: store.address,
    },
  })}
/>

<link rel="preconnect" href="https://rsms.me/" />
<link rel="stylesheet" href="https://rsms.me/inter/inter.css" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap"
  rel="stylesheet"
/>
