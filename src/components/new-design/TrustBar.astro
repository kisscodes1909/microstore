---
import LucideIcon from "@/components/icons/LucideIcon";
import type { LucideIconName } from "@/components/icons/LucideIcon";

const items: {
  title: string;
  desc: string;
  color: string;
  bg: string;
  icon: LucideIconName;
}[] = [
  {
    title: "Giao hàng miễn phí",
    desc: "Áp dụng đơn từ 1.500.000 ₫",
    color: "text-blue-600",
    bg: "bg-blue-50",
    icon: "truck",
  },
  {
    title: "Bảo hành chính hãng",
    desc: "12–24 tháng tùy dòng sản phẩm",
    color: "text-green-600",
    bg: "bg-green-50",
    icon: "shieldCheck",
  },
  {
    title: "Tư vấn trực tiếp",
    desc: "Hỗ trợ trong khung giờ mở cửa",
    color: "text-purple-600",
    bg: "bg-purple-50",
    icon: "headphones",
  },
  {
    title: "Uy tín lâu đời",
    desc: "Hơn 30 năm kinh nghiệm tại Huế",
    color: "text-orange-600",
    bg: "bg-orange-50",
    icon: "badgeCheck",
  },
];
---

<section class="bg-section-muted border-t border-blue-100/50 py-5 sm:py-0">
  <!-- Mobile: scroll ngang -->
  <div class="flex overflow-x-auto gap-3 px-4 sm:hidden scrollbar-none">
    {items.map((item) => (
      <div class="flex items-center gap-3 bg-white border border-gray-100 rounded-2xl px-4 py-3.5 shrink-0 min-w-[210px] shadow-sm">
        <div class={`${item.bg} p-2.5 rounded-xl shrink-0 flex items-center justify-center`}>
          <LucideIcon name={item.icon} className={`w-4.5 h-4.5 ${item.color}`} aria-hidden="true" />
        </div>
        <div>
          <div class="font-bold text-gray-800 text-sm leading-tight">{item.title}</div>
          <div class="text-gray-500 text-xs mt-0.5">{item.desc}</div>
        </div>
      </div>
    ))}
  </div>

  <!-- Desktop: grid 4 cột -->
  <div class="hidden sm:grid grid-cols-2 lg:grid-cols-4 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {items.map((item, i) => (
      <div class={`flex items-center gap-3.5 px-5 py-6 ${i !== items.length - 1 ? "border-r border-blue-100/60" : ""}`}>
        <div class={`${item.bg} p-2.5 rounded-xl shrink-0 flex items-center justify-center`}>
          <LucideIcon name={item.icon} className={`w-5 h-5 ${item.color}`} aria-hidden="true" />
        </div>
        <div>
          <div class="font-bold text-gray-800 text-sm leading-tight">{item.title}</div>
          <div class="text-gray-500 text-xs mt-0.5">{item.desc}</div>
        </div>
      </div>
    ))}
  </div>
</section>
