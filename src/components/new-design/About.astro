---
import { store } from "@/data/store";
import LucideIcon from "@/components/icons/LucideIcon";

const highlights = [
  "Tư vấn chọn size, lắp ráp và bảo hành rõ ràng",
  "Có xe thể thao, xe trẻ em và phụ tùng xe điện",
  "Bảo dưỡng & sửa chữa nhanh tại cửa hàng",
  "Hỗ trợ báo giá nhanh qua Zalo",
  "Phù hợp khách lẻ và đơn vị mua số lượng",
] as const;

const stats: { value: string; label: string; showStar?: boolean }[] = [
  { value: "20+", label: "Mẫu tham khảo" },
  { value: store.area, label: "Khu vực" },
  { value: store.hours, label: "Mở cửa" },
  { value: "4.9", label: "Đánh giá", showStar: true },
];
---

<section id="about" class="py-10 sm:py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-16 items-center">
      <div class="relative order-1">
        <div class="rounded-2xl overflow-hidden shadow-xl">
          <img
            src="https://images.unsplash.com/photo-1600327713015-08077f65b388?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1080"
            alt={`${store.brand} — cửa hàng`}
            class="w-full h-52 sm:h-72 object-cover"
            loading="lazy"
          />
        </div>
        <div class="hidden sm:block absolute -bottom-5 right-6 w-36 sm:w-44 h-28 sm:h-36 rounded-xl overflow-hidden shadow-xl border-4 border-white">
          <img
            src="https://images.unsplash.com/photo-1671543445386-36520a3fcca2?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=400"
            alt="Xưởng kỹ thuật"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="absolute top-3 left-3 bg-white rounded-xl px-3 py-2 shadow-lg border border-gray-100 flex items-center gap-2">
          <LucideIcon name="star" className="w-5 h-5 text-amber-400 fill-amber-400 shrink-0" aria-hidden="true" />
          <div>
            <div class="font-black text-gray-800 text-sm leading-none">4.9 / 5</div>
            <div class="text-gray-500 text-[10px] leading-none mt-0.5">Google Reviews</div>
          </div>
        </div>
      </div>

      <div class="order-2">
        <p class="text-blue-600 text-xs font-semibold uppercase tracking-wider mb-2">Về chúng tôi</p>
        <h2 class="text-gray-900 mb-4" style="font-size:clamp(1.4rem,5vw,2.2rem);font-weight:800;line-height:1.2;">
          Cửa hàng xe đạp{" "}
          <span class="text-blue-600">{store.brand}</span>
          <br />
          tại {store.area}
        </h2>
        <p class="text-gray-600 leading-relaxed mb-5 text-sm sm:text-base">
          {store.description} {store.tagline}
        </p>

        <ul class="space-y-2.5 mb-6">
          {highlights.map((item) => (
            <li class="flex items-start gap-2.5">
              <LucideIcon name="check" className="w-4 h-4 text-blue-600 mt-0.5 shrink-0" aria-hidden="true" />
              <span class="text-gray-700 text-sm">{item}</span>
            </li>
          ))}
        </ul>

        <div class="grid grid-cols-4 gap-2 border border-blue-100 rounded-2xl overflow-hidden">
          {stats.map((s, i) => (
            <div class={`text-center py-3 sm:py-4 px-1 ${i !== stats.length - 1 ? "border-r border-blue-100" : ""}`}>
              <div class="text-blue-700 font-black leading-none flex items-center justify-center gap-0.5" style="font-size:clamp(0.9rem,3vw,1.3rem);">
                {s.showStar ? (
                  <>
                    {s.value}
                    <LucideIcon name="star" className="w-3.5 h-3.5 text-amber-400 fill-amber-400 shrink-0" aria-hidden="true" />
                  </>
                ) : (
                  s.value
                )}
              </div>
              <div class="text-gray-500 text-[9px] sm:text-xs mt-1 leading-tight">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

