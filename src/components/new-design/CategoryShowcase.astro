---
import { CATEGORIES } from "@/react-app/data/products";
import { showProductsSection } from "@/config/site";
import { Image } from "astro:assets";
const linkProducts = showProductsSection;
---

<section id="categories" class="py-8 sm:py-16 bg-gray-50 border-t border-blue-100/50">
  <div class="max-w-7xl mx-auto">
    <div class="flex items-end justify-between mb-5 px-4 sm:px-6 lg:px-8">
      <div>
        <p class="text-blue-600 text-xs font-semibold uppercase tracking-wider mb-1">Danh mục</p>
        <h2 class="text-gray-900" style="font-size:clamp(1.2rem,4vw,2rem);font-weight:800;">Xe Đạp Calli</h2>
      </div>
      <!-- {linkProducts ? (
        <a href="/products/" class="flex items-center gap-1 text-blue-600 hover:text-blue-700 text-sm font-semibold transition-colors shrink-0">
          Xem tất cả <span class="font-black">→</span>
        </a>
      ) : (
        <span class="text-gray-400 text-sm font-medium shrink-0">Cập nhật danh sách sản phẩm sớm</span>
      )} -->
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-8 px-4 sm:px-6 lg:px-8">
      {CATEGORIES.map((cat) => (
        linkProducts ? (
          <a
            href={`/products/?category=${encodeURIComponent(cat.name)}`}
            class="group catalog-card catalog-card--interactive"
          >
            <div class="catalog-card__media ">
              <Image src={cat.image} alt={cat.name} densities={[1.5, 2]} width={1024} height={576} loading="lazy" decoding="async" class="!object-contain" />
            </div>
            <div class="catalog-card__body">
              <h3 class="font-bold text-gray-900 text-sm md:text-xl leading-snug line-clamp-2">{cat.name}</h3>
              <p class="text-gray-500 text-xs leading-relaxed line-clamp-2 flex-1">{cat.desc}</p>
              <span class="mt-2 text-blue-600 text-xs font-semibold inline-flex items-center gap-0.5">
                Xem sản phẩm <span class="font-black" aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        ) : (
          <div class="catalog-card shadow-md">
            <div class="catalog-card__media bg-white">
              <Image src={cat.image} alt={cat.name} densities={[1.5, 2]} width={1024} height={576} loading="lazy" decoding="async" class="!object-contain" />
            </div>
            <div class="catalog-card__body">
              <h3 class="font-bold text-gray-900 text-sm md:text-xl leading-snug line-clamp-2 capitalize">{cat.name}</h3>
              <p class="text-gray-500 text-xs leading-relaxed line-clamp-3">{cat.desc}</p>
              {/* <p class="mt-2 text-gray-400 text-[11px] leading-snug">Liên hệ để được tư vấn — trang sản phẩm sẽ sớm mở.</p> */}
            </div>
          </div>
        )
      ))}
    </div>
  </div>
</section>
