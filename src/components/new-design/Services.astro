---
import LucideIcon from "@/components/icons/LucideIcon";
import type { LucideIconName } from "@/components/icons/LucideIcon";

const services: {
  title: string;
  desc: string;
  time: string;
  light: string;
  iconColor: string;
  icon: LucideIconName;
}[] = [
  {
    title: "Sửa chữa & Bảo dưỡng",
    desc: "Đội thợ lành nghề, xử lý nhanh mọi loại xe đạp từ xe đua đến xe điện.",
    time: "30 phút – 2 giờ",
    light: "bg-blue-50",
    iconColor: "text-blue-600",
    icon: "wrench",
  },
  {
    title: "Thay linh kiện chính hãng",
    desc: "Cung cấp và lắp đặt phụ tùng chính hãng — tư vấn đúng nhu cầu.",
    time: "Ngay trong ngày",
    light: "bg-green-50",
    iconColor: "text-green-600",
    icon: "puzzle",
  },
  {
    title: "Căn chỉnh & Setup",
    desc: "Tinh chỉnh phanh, truyền động và tư thế lái theo thông số chuẩn.",
    time: "1 – 3 giờ",
    light: "bg-orange-50",
    iconColor: "text-orange-500",
    icon: "settings",
  },
  {
    title: "Nâng cấp xe điện",
    desc: "Nâng cấp pin, motor và hệ thống điện tử cho e-bike.",
    time: "Theo yêu cầu",
    light: "bg-purple-50",
    iconColor: "text-purple-600",
    icon: "zap",
  },
  {
    title: "Phụ kiện & Bảo hộ",
    desc: "Mũ bảo hiểm, găng tay, đèn, túi yên và nhiều phụ kiện khác.",
    time: "Có sẵn tại kho",
    light: "bg-rose-50",
    iconColor: "text-rose-500",
    icon: "hardHat",
  },
  {
    title: "Tư vấn chọn xe",
    desc: "Giúp bạn chọn xe phù hợp với nhu cầu, chiều cao và ngân sách.",
    time: "Hoàn toàn miễn phí",
    light: "bg-teal-50",
    iconColor: "text-teal-600",
    icon: "users",
  },
];
---

<section id="services" class="py-14 sm:py-24 bg-section-tint border-t border-blue-100/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Heading canh giữa -->
    <div class="text-center mb-10 sm:mb-14">
      <p class="text-blue-600 text-xs font-bold uppercase tracking-widest mb-2">Dịch vụ</p>
      <h2 class="text-gray-900 mx-auto" style="font-size:clamp(1.5rem,5vw,2.4rem);font-weight:800;line-height:1.2;max-width:30ch;">
        Dịch vụ toàn diện,{" "}
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-sky-500">tận tâm</span>
      </h2>
      <p class="text-gray-500 text-sm sm:text-base mt-3 max-w-2xl mx-auto leading-relaxed">
        Từ bảo dưỡng định kỳ đến nâng cấp chuyên sâu — tất cả tại một nơi.
      </p>
    </div>

    <!-- Mobile: cuộn ngang -->
    <div class="flex gap-3 overflow-x-auto pb-4 -mx-4 px-4 sm:hidden scrollbar-none">
      {services.map((s) => (
        <div class="bg-white rounded-2xl p-4 border border-gray-100 shadow-sm shrink-0 flex flex-col" style="width:72vw;min-width:240px;">
          <div class={`w-10 h-10 rounded-xl flex items-center justify-center mb-3 ${s.light}`}>
            <LucideIcon name={s.icon} className={`w-5 h-5 ${s.iconColor}`} aria-hidden="true" />
          </div>
          <h3 class="font-bold text-gray-800 mb-1.5 text-sm leading-snug">{s.title}</h3>
          <p class="text-gray-500 text-xs leading-relaxed mb-3 flex-1">{s.desc}</p>
          <span class="text-xs text-gray-400 font-medium bg-gray-50 px-3 py-1.5 rounded-full border border-gray-100 w-fit inline-flex items-center gap-1.5">
            <LucideIcon name="timer" className="w-3.5 h-3.5 shrink-0 opacity-70" aria-hidden="true" />
            {s.time}
          </span>
        </div>
      ))}
    </div>

    <!-- Desktop: lưới 3 cột -->
    <div class="hidden sm:grid grid-cols-2 lg:grid-cols-3 gap-5">
      {services.map((s) => (
        <div class="group bg-white rounded-2xl p-6 border border-gray-100 hover:border-blue-200 hover:shadow-xl transition-all duration-300">
          <div class={`w-11 h-11 rounded-xl flex items-center justify-center mb-4 ${s.light} transition-colors duration-300`}>
            <LucideIcon name={s.icon} className={`w-5 h-5 ${s.iconColor}`} aria-hidden="true" />
          </div>
          <h3 class="font-bold text-gray-800 mb-2 text-base">{s.title}</h3>
          <p class="text-gray-500 text-sm leading-relaxed mb-4">{s.desc}</p>
          <span class="text-xs text-gray-400 font-medium bg-gray-50 px-3 py-1.5 rounded-full border border-gray-100 inline-flex items-center gap-1.5">
            <LucideIcon name="timer" className="w-3.5 h-3.5 shrink-0 opacity-70" aria-hidden="true" />
            {s.time}
          </span>
        </div>
      ))}
    </div>

    <!-- Banner CTA -->
    <a class="relative rounded-2xl overflow-hidden block mt-10" href="/#contact">
      <img
        src="https://images.unsplash.com/photo-1605559424843-9e4c228bf1c2?auto=format&fit=crop&w=1200&h=400&q=80"
        alt="Xưởng kỹ thuật"
        class="w-full object-cover h-44 sm:h-60"
        width="1200"
        height="400"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-gray-950/90 via-gray-900/70 to-transparent flex items-center">
        <div class="px-6 sm:px-10 py-6 max-w-lg">
          <h3 class="text-white font-black mb-2" style="font-size:clamp(1rem,4vw,1.5rem);">
            Xưởng kỹ thuật chuyên nghiệp
          </h3>
          <p class="text-gray-300 text-sm mb-4 hidden sm:block leading-relaxed">
            Máy móc chuyên dụng, hỗ trợ căn chỉnh và bảo dưỡng nhanh — không cần hẹn trước.
          </p>
          <span class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-500 text-white px-5 py-3 rounded-xl text-sm font-bold transition-colors min-h-[44px]">
            Liên hệ ngay <span class="font-black">→</span>
          </span>
        </div>
      </div>
    </a>
  </div>
</section>
