---
import { store } from "@/data/store";
import { CATEGORIES } from "@/react-app/data/products";
import LucideIcon from "@/components/icons/LucideIcon";
import logoUrl from "@/images/logo.svg?url";
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white shadow-sm">
  <!-- TopBar (desktop) -->
  <div class="hidden md:block bg-blue-800 text-blue-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-9 text-xs relative">
        <div class="flex items-center gap-5">
          <a href={`tel:${store.phoneTel}`} class="flex items-center gap-1.5 hover:text-white transition-colors">
            <LucideIcon name="phone" className="h-3.5 w-3.5 shrink-0 opacity-90" aria-hidden="true" />
            {store.phoneDisplay}
          </a>
          <span class="flex items-center gap-1.5">
            <LucideIcon name="clock" className="h-3.5 w-3.5 shrink-0 opacity-90" aria-hidden="true" />
            {store.hours}
          </span>
        </div>
        <div class="absolute left-1/2 -translate-x-1/2 flex items-center gap-1.5">
          <LucideIcon name="partyPopper" className="h-3.5 w-3.5 text-yellow-300 shrink-0" aria-hidden="true" />
          <span class="text-white font-medium">Tư vấn miễn phí · Báo giá nhanh qua Zalo</span>
        </div>
        <div class="flex items-center gap-3 text-xs text-blue-200">
          <a href={store.mapsPlaceUrl} target="_blank" rel="noreferrer" class="hover:text-white transition-colors">Bản đồ</a>
          <a href={store.zaloUrl} target="_blank" rel="noreferrer" class="hover:text-white transition-colors">Zalo</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Main bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between py-2.5 md:py-3 min-h-[80px] md:min-h-[84px]">
      <a href="/" class="flex shrink-0 min-w-0">
        <img
          src={logoUrl}
          alt={store.brand}
          width="250"
          height="150"
          class="h-[60px] w-auto max-w-[min(320px,72vw)] object-contain object-left"
        />
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-1">
        <a href="/" class="px-4 py-2 text-sm font-medium rounded-lg transition-colors text-gray-700 hover:text-blue-600 hover:bg-blue-50">
          Trang chủ
        </a>

        <div class="relative group">
          <a
            href="/products/"
            class="flex items-center gap-1 px-4 py-2 text-sm font-medium rounded-lg transition-colors text-gray-700 hover:text-blue-600 hover:bg-blue-50"
          >
            Sản phẩm
          </a>
          <div class="absolute top-full left-0 w-52 bg-white shadow-xl rounded-xl border border-gray-100 py-2 mt-1 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
            <a
              href="/products/"
              class="block px-4 py-2.5 text-sm text-gray-600 hover:text-blue-600 hover:bg-blue-50 font-semibold border-b border-gray-50 mb-1"
            >
              Tất cả sản phẩm
            </a>
            {CATEGORIES.map((cat) => (
              <a
                href={`/products/?category=${encodeURIComponent(cat.name)}`}
                class="block px-4 py-2 text-sm text-gray-600 hover:text-blue-600 hover:bg-blue-50 transition-colors"
              >
                {cat.name}
              </a>
            ))}
          </div>
        </div>

        <a href="/#about" class="px-4 py-2 text-gray-700 hover:text-blue-600 text-sm font-medium transition-colors rounded-lg hover:bg-blue-50">
          Giới thiệu
        </a>
        <a href="/#services" class="px-4 py-2 text-gray-700 hover:text-blue-600 text-sm font-medium transition-colors rounded-lg hover:bg-blue-50">
          Dịch vụ
        </a>
        <a href="/#contact" class="px-4 py-2 text-gray-700 hover:text-blue-600 text-sm font-medium transition-colors rounded-lg hover:bg-blue-50">
          Liên hệ
        </a>
      </nav>

      <div class="flex items-center gap-2">
        <a
          href={`tel:${store.phoneTel}`}
          class="hidden sm:flex items-center gap-1.5 bg-blue-600 hover:bg-blue-700 text-white px-3 py-2 rounded-xl text-sm font-semibold transition-colors min-h-[40px]"
        >
          <LucideIcon name="phone" className="h-4 w-4 shrink-0" aria-hidden="true" />
          <span class="hidden md:inline">{store.phoneDisplay}</span>
          <span class="md:hidden">Gọi</span>
        </a>
        <button
          class="lg:hidden p-2 rounded-xl hover:bg-gray-100 transition-colors min-w-[44px] min-h-[44px] flex items-center justify-center"
          aria-label="Mở menu"
          data-nd-open
        >
          <LucideIcon name="menu" className="h-6 w-6 text-gray-700" strokeWidth={2.25} aria-hidden="true" />
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile overlay panel (SSG markup + small JS island) -->
  <div class="fixed inset-0 z-[100] lg:hidden hidden" data-nd-overlay>
    <div class="absolute inset-0 bg-gray-950/60 backdrop-blur-sm" data-nd-close></div>
    <div class="absolute top-0 right-0 bottom-0 w-[85vw] max-w-sm bg-white flex flex-col shadow-2xl">
      <div class="flex items-center justify-between px-5 py-3 border-b border-gray-100">
        <div class="flex items-center min-w-0">
          <img
            src={logoUrl}
            alt={store.brand}
            width="250"
            height="150"
            class="h-[60px] w-auto max-w-[min(280px,75vw)] object-contain object-left"
          />
        </div>
        <button
          class="p-2 rounded-xl hover:bg-gray-100 transition-colors min-w-[44px] min-h-[44px] flex items-center justify-center"
          aria-label="Đóng menu"
          data-nd-close
        >
          <LucideIcon name="x" className="h-5 w-5 text-gray-500" strokeWidth={2.5} aria-hidden="true" />
        </button>
      </div>

      <div class="flex-1 overflow-y-auto py-3">
        <a class="w-full flex items-center gap-3 px-5 py-4 text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors text-left min-h-[56px] border-b border-gray-50" href="/">
          <span class="font-semibold">Trang chủ</span>
        </a>
        <a class="w-full flex items-center gap-3 px-5 py-4 text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors text-left min-h-[56px] border-b border-gray-50" href="/#about">
          <span class="font-semibold">Giới thiệu</span>
        </a>
        <a class="w-full flex items-center gap-3 px-5 py-4 text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors text-left min-h-[56px] border-b border-gray-50" href="/#services">
          <span class="font-semibold">Dịch vụ</span>
        </a>
        <a class="w-full flex items-center gap-3 px-5 py-4 text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors text-left min-h-[56px] border-b border-gray-50" href="/#contact">
          <span class="font-semibold">Liên hệ</span>
        </a>
        <a class="w-full flex items-center gap-3 px-5 py-4 text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors text-left min-h-[56px] border-b border-gray-50" href="/products/">
          <span class="font-semibold">Sản phẩm</span>
        </a>
      </div>

      <div class="p-4 border-t border-gray-100 flex gap-3">
        <a
          href={`tel:${store.phoneTel}`}
          class="flex-1 flex items-center justify-center gap-2 bg-blue-600 text-white rounded-2xl py-3.5 font-bold text-sm min-h-[52px]"
          data-nd-close
        >
          Gọi ngay
        </a>
        <a
          href={store.zaloUrl}
          target="_blank"
          rel="noreferrer"
          class="flex-1 flex items-center justify-center gap-2 bg-teal-500 text-white rounded-2xl py-3.5 font-bold text-sm min-h-[52px]"
          data-nd-close
        >
          Zalo
        </a>
      </div>
    </div>
  </div>

  <script is:inline>
    {String.raw`
      (() => {
        const overlay = document.querySelector('[data-nd-overlay]');
        const openBtn = document.querySelector('[data-nd-open]');
        const closeBtns = document.querySelectorAll('[data-nd-close]');
        if (!overlay || !openBtn) return;

        const open = () => {
          overlay.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        };
        const close = () => {
          overlay.classList.add('hidden');
          document.body.style.overflow = '';
        };

        openBtn.addEventListener('click', open);
        closeBtns.forEach((b) => b.addEventListener('click', close));
      })();
    `}
  </script>
</header>

